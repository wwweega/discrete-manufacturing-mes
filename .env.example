# =============================================================================
# 复制为 .env 后按需修改（后端启动时会自动读取仓库根目录的 .env）
# =============================================================================

# ---------------- 应用 ----------------
APP_NAME=离散制造车间生产管理系统
APP_ENV=dev
DEBUG=true

# ---------------- 数据库：sqlite | mysql ----------------
DB_ENGINE=sqlite
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=mes123456
MYSQL_DB=mes
# SQLite 文件路径（相对仓库根目录）
SQLITE_PATH=data/mes.db

# ---------------- Redis ----------------
# REDIS_ENABLED=false、主机留空或连接失败时，自动降级为进程内内存缓存，
# 接口语义与 Redis 完全一致，功能不受影响
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
DEVICE_STATUS_TTL_SEC=600

# ---------------- 安全 ----------------
SECRET_KEY=please-change-this-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---------------- 设备数采网关 ----------------
GATEWAY_ENABLED=true
GATEWAY_INTERVAL_SEC=3
SSE_HEARTBEAT_SEC=15
SSE_PUSH_INTERVAL_SEC=2

# ---------------- SPC ----------------
SPC_DEFAULT_SUBGROUP_SIZE=5
SPC_RULE_SET=1,2,3,5,6

# ---------------- 前端静态资源：dist | standalone ----------------
FRONTEND_PREFER=dist
